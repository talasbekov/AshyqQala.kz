# Caddy reverse-proxy (Story 1.7, walking skeleton). Байт: браузер→Caddy→(SPA | api:8080→chi→pgx→Postgres).
# Локально :80 без TLS; авто-TLS (Let's Encrypt) — прод-настройка позже.
:80 {
	# /metrics НЕ публикуется наружу (deferred-work → Story 1.7): на публичном edge — 404.
	# Метрики chi остаются доступны ТОЛЬКО внутри docker-сети на api:8080 (внутренние IP).
	handle /metrics* {
		respond 404
	}

	# /api/* → chi (cmd/api). Путь передаётся как есть: chi обслуживает /api/contracts/{id}.
	handle /api/* {
		reverse_proxy api:8080
	}

	# /og/* → chi (Story 5.5, FR-27): серверный OG-рендер карточки (HTML с OG-тегами + версионированная
	# картинка). Шаринговый URL карточки — /og/contracts/{id}. ⏳ Детекция соц-краулеров на /contracts/{id}
	# (чтобы и канонический URL отдавал OG-теги) — отложенное решение (OQ#2): по user-agent или всегда-SSR.
	handle /og/* {
		reverse_proxy api:8080
	}

	# SPA: статика web/dist + фолбэк на index.html для client-side маршрутов (React Router).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
