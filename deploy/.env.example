# Пример окружения для deploy/. Скопировать в deploy/.env (он в .gitignore — секреты вне репо).
# Изоляция токена: GOSZAKUP_TOKEN виден ТОЛЬКО importer (cold-профиль), НЕ api.

# --- Postgres + PostGIS ---
POSTGRES_USER=ashyqqala
POSTGRES_PASSWORD=change-me-in-real-env
POSTGRES_DB=ashyqqala
# Публикуемый порт на хосте (меняйте, если 5432 занят локальным Postgres)
POSTGRES_PORT=5432

# --- ows_v2 (только для importer; Epic 2) ---
# GOSZAKUP_TOKEN=

# --- Telegram bot (Epic 7) ---
# TELEGRAM_BOT_TOKEN=

# --- Directus (внутренняя админка, cold-профиль 'directus'; Story 3.2) ---
# Секрет подписи сессий (любая длинная случайная строка) и бутстрап-админ. В dev работают дефолты
# из docker-compose.cold.yml; вне dev задать ОБЯЗАТЕЛЬНО. Порт 8055 — только loopback (SSH-туннель).
# DIRECTUS_SECRET=
# DIRECTUS_ADMIN_EMAIL=
# DIRECTUS_ADMIN_PASSWORD=
