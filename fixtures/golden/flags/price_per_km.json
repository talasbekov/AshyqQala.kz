    { "name": "нет медианы → insufficient_data", "price_per_km": 2000000, "median": null, "sample_size": 5, "expected": "insufficient_data" },
    { "name": "нет цены/км (нет длины) → insufficient_data", "price_per_km": null, "median": 1000000, "sample_size": 5, "expected": "insufficient_data" }
